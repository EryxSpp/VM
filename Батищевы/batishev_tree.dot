digraph Батищевы {
fontname="Roboto,Helvetica,Arial,sans-serif"
fontsize=18.0
node [fontname="Roboto,Helvetica,Arial,sans-serif", fontsize=12, color=silver, style=filled, fillcolor=white, width=1, height=0.5, regular=1]
edge [fontname="Roboto,Helvetica,Arial,sans-serif", fontsize=12, color=silver, weight=1]

# page = "8.2677165,11.692913" ;
#
mincross = 2.0 ;
mclimit = 2.0; 
label = "\n\nГенеалогическое древо Батищевых" ;
imagescale = true;

TPA[shape=house, fixedsize=true, regular=0,label="Батищевы"];
TMA[shape=house, fixedsize=true, regular=0,label="?"];
TPB[shape=house, fixedsize=true, regular=0,label="Сургучёвы"];
TMB[shape=house, fixedsize=true, regular=0,label="Крупские"];
TC1[shape=house, fixedsize=true, regular=0,label="Бутт"];
TC2[shape=house, fixedsize=true, regular=0,label="Хребтовы"];
TC3[shape=house, fixedsize=true, regular=0,label="Ясинчук"];
PA[shape=box,     label="?"];
MA[shape=circle,  label="?"];
PB[shape=box,     label="Яков\nГригорьевич\nСургучёв", width=1];
MB[shape=circle,  label="Дарья\nМаксимовна\nСургучёва", width=1];
A [shape=box,     label=" Василий \n  Иванович  \n Батищев ", width=1, URL="/VM/Батищевы/Василий_Иванович/index.html", color=blue];
B [shape=circle,  label="Антонина\nЯковлевна\nБатищева", width=1, URL="/VM/Батищевы/Антонина_Яковлевна/index.html", color=blue];
C1 [shape=circle, label="Галина\nВасильевна\nБутт", width=1, URL="/VM/Батищевы/Галина_Васильевна/index.html", color=blue];
C2 [shape=circle, label="Екатерина\nВасильевна\nХребтова", width=1, URL="/VM/Батищевы/Екатерина_Васильевна/index.html", color=blue];
C3 [shape=circle, label="Надежда\nВасильевна\nЯсинчук", width=1, URL="/VM/Батищевы/Надежда_Васильевна/index.html", color=blue];
XA [shape=diamond, label="",height=.1,width=.1];
XB [shape=diamond, label="",height=.1,width=.1]; 
XC [shape=diamond, label="",height=.1,width=.1];
TPA -> PA;
TMA -> MA;
PA -> XA[dir=none];
MA -> XA[dir=none];
XA -> A[weight=1];
TPB -> PB;
TMB -> MB;
PB -> XB[dir=none];
MB -> XB[dir=none];
XB -> B[weight=1];
A -> XC[dir=none];
B -> XC[dir=none];
XC -> C1;
XC -> C2;
XC -> C3;
C1 ->TC1;
C2 ->TC2;
C3 ->TC3;
}